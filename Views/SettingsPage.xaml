<Page x:Class="ClearWin.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings" Foreground="White">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="App Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>
            <TextBlock Text="ClearWin v2.7.7" FontWeight="SemiBold" Opacity="0.8"/>
            <TextBlock Text="Glassmorphism UI accelerated by DWM (Mica)" Opacity="0.5" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Page>
